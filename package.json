{
  "name": "Endhalla",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "android:client:testing": "echo client > .app_target && APP_TARGET=client ENVFILE=.env.testing react-native run-android --mode=clientStagingDebug",
    "android:counsellor:testing": "echo counsellor > .app_target && APP_TARGET=counsellor ENVFILE=.env.testing react-native run-android --mode=counsellorStagingDebug",
    "ios:client:testing": "echo client > .app_target && APP_TARGET=client ENVFILE=.env.testing react-native run-ios",
    "ios:counsellor:testing": "echo counsellor > .app_target && APP_TARGET=counsellor ENVFILE=.env.testing react-native run-ios",
    "start": "react-native start",
    "start:client": "echo client > .app_target && APP_TARGET=client react-native start",
    "start:counsellor": "echo counsellor > .app_target && APP_TARGET=counsellor react-native start",
    "lint": "eslint .",
    "test": "jest",
    "postinstall": "patch-package",
    "pod-install": "cd ios && pod install",
    "setup": "npm install && cd ios && pod install"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-community/datetimepicker": "^9.1.0",
    "@react-native/new-app-screen": "0.86.0",
    "@react-navigation/bottom-tabs": "^7.18.11",
    "@react-navigation/native": "^7.3.11",
    "@react-navigation/native-stack": "^7.18.3",
    "@reduxjs/toolkit": "^2.12.0",
    "date-fns": "^4.4.0",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-calendars": "^1.1314.0",
    "react-native-config": "^1.6.1",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.36.5",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.26.2",
    "react-native-sound": "^0.13.0",
    "react-native-svg": "^15.15.5",
    "react-redux": "^9.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.86.0",
    "@react-native/eslint-config": "0.86.0",
    "@react-native/metro-config": "0.86.0",
    "@react-native/typescript-config": "0.86.0",
    "@types/jest": "^29.5.13",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "patch-package": "^8.0.0",
    "postinstall-postinstall": "^2.1.0",
    "react-native-svg-transformer": "^1.5.3",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
